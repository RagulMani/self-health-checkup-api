# ==============================================
# Environment Variables — API service
# ==============================================

# Database (the API service owns the schema and the pool)
DATABASE_URL=postgresql://user:password@localhost:5432/myapp

# Dual7 release migration range (npm run db:migrate against a BYO database)
# MIGRATION_START=1
# MIGRATION_END=1

# JWT auth (platform auth bundle under src/auth/)
JWT_SECRET=your-jwt-secret-here

# Port the Node adapter listens on (Lambda ignores this)
PORT=3000
